# docker compose reads this automatically.

# On Windows/macOS the official docs say to use 50000 for the container user.
AIRFLOW_UID=50000

# local  -> DAG 04 runs the iceberg_deep scripts with Spark inside the container
# emr    -> DAG 04 submits the same scripts to EMR Serverless
LAB_MODE=local

# Only needed for LAB_MODE=emr. Leave blank for local practice.
EMR_APPLICATION_ID=
EMR_EXECUTION_ROLE_ARN=
LAB_S3_BUCKET=
AWS_DEFAULT_REGION=us-east-1

AIRFLOW__API_AUTH__JWT_SECRET=nbs_lab_jwt_secret_change_me
